# Copy this file to .env, fill it in, then restart with:  npx expo start --clear
# Everything here is optional. With an empty .env the app runs in demo mode
# (data stays on the phone, the coach answers from stored tips).

# --- Firebase (Authentication + Cloud Firestore, free Spark plan) ---
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- AI coach ---
# Address of the coach server in /server. On a phone, use your laptop's Wi-Fi address,
# not "localhost". Example: http://192.168.1.20:8787
EXPO_PUBLIC_COACH_API_URL=

# --- Pose model files (optional) ---
# Leave empty to load MediaPipe from the public CDN. Set both to host the files yourself.
# If the camera struggles to find the learner, try the larger model (more accurate, slower):
# EXPO_PUBLIC_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task
EXPO_PUBLIC_POSE_VISION_BASE=
EXPO_PUBLIC_POSE_MODEL_URL=
