{
  "expo": {
    "name": "Cricket Coach",
    "slug": "cricket-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cricketcoach",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to check your batting technique. The video is checked on your phone and is never uploaded."
      },
      "bundleIdentifier": "com.anonymous.cricket-coach"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to check your batting technique. The video is checked on your phone and is never uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo of your grip so the coach can check it.",
          "cameraPermission": "Take a photo of your grip so the coach can check it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5D3B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ]
  }
}
