# Copy this file to .env and fill in ONE of the options below.
# Never put these values in the mobile app.

PORT=8787

# Which AI? All three below work with this server. For Sinhala, Gemini or Claude answer far
# better than the small Groq model. Uncomment ONE block (remove the # at the start of its lines).

# Option 1: Google Gemini (recommended: free tier, good Sinhala, can see pictures).
# Get a key at https://aistudio.google.com  (Get API key). Model names change: use a "flash"
# model listed in AI Studio.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=paste-your-gemini-key-here
# LLM_MODEL=gemini-3.8-flash
# LLM_VISION_MODEL=gemini-3.8-flash

# Option 2: Claude (Anthropic). Very good Sinhala and coaching; paid per use (add credit first).
# Get a key at https://console.anthropic.com  (API keys).
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=paste-your-claude-key-here
# LLM_MODEL=claude-sonnet-5-5
# LLM_VISION_MODEL=claude-sonnet-5-5

# Option 3: Groq. Free tier, very fast, but weak in Sinhala. Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional: extra settings sent with every request, as JSON. Check your provider's docs first.
# LLM_EXTRA_JSON={"reasoning_effort":"low"}

# Option 4: Ollama on this laptop. No key, no cost, works offline. Slower; poor Sinhala.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2:3b
# LLM_VISION_MODEL=llava

# The grip photo check uses LLM_VISION_MODEL (set in each option above). Leave it empty
# (LLM_VISION_MODEL=) to switch the grip photo check off.

# Upper limit on the length of an answer. Sinhala needs more tokens than English: keep 900.
LLM_MAX_TOKENS=900

# How varied the answers are (0 to 1). Leave unset: 0.4, or left out for Claude.
# LLM_TEMPERATURE=0.4
